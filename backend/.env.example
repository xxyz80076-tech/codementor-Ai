# Copy this file to ".env" and fill in your own values

# Get your free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set a model available to your key. The default is gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Get your API key from https://api.together.ai (used for image generation — has a free tier)
TOGETHER_API_KEY=your_together_api_key_here

# Get this from https://console.cloud.google.com/apis/credentials (OAuth Client ID, type "Web application")
# Must match the same client ID used in frontend/.env
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Any long random string — used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

PORT=5000
